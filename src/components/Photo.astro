---
import photos from '../config/photos.json';
import type { PhotoId } from '../data/facts';
import type { Copy } from '../i18n/en';

interface Props {
  id: PhotoId;
  copy: Copy;
  /** `sizes` attribute for the responsive image. */
  sizes: string;
  class?: string;
}
const { id, copy, sizes, class: className } = Astro.props;
const p = photos[id];
const t = copy.photos.items[id];
const isPublicDomain = /public domain/i.test(p.license);
---

<figure class:list={['photo reveal', className]} style={`--ar:${p.width / p.height}`}>
  <div class="crop">
    <img
      src={p.files[1]?.src ?? p.files[0].src}
      srcset={p.files.map((f) => `${f.src} ${f.w}w`).join(', ')}
      sizes={sizes}
      width={p.width}
      height={p.height}
      alt={t.alt}
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption>
    <span class="caption">{t.caption}</span>
    <span class="credit muted">
      {copy.photos.by} <a href={p.page} rel="noopener">{p.author}</a>{', '}
      {isPublicDomain || !p.licenseUrl ? p.license.toLowerCase() : <a href={p.licenseUrl} rel="noopener license">{p.license}</a>}
      {`, ${copy.photos.edited}`}
    </span>
  </figcaption>
</figure>

<style>
  .photo {
    display: grid;
    gap: 0.75rem;
    width: 100%;
  }

  .crop {
    overflow: hidden;
    aspect-ratio: var(--ar);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  figcaption {
    display: grid;
    gap: 0.15rem;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .caption {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .credit a {
    text-decoration-color: var(--line);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) img {
      transform: scale(1.07);
      transition: transform 2.2s var(--ease-out);
    }

    :global(.js) .photo:global(.is-in) img {
      transform: none;
    }
  }
</style>
