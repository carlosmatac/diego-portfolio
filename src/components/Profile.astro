---
import type { Copy } from '../i18n/en';
import Sketch from './Sketch.astro';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const c = copy.profile;
---

<section class="section surface-dark profile" id="profile" aria-labelledby="profile-title">
  <div class="wrap">
    <div class="grid top">
    <h2 class="display statement" id="profile-title">
      {
        c.title.map((line, i) => (
          <span class="line reveal" style={`--d:${i * 120}ms`}>
            {line}
          </span>
        ))
      }
    </h2>
    <Sketch id="tierra" class="globe" />
    </div>

    <div class="grid body">
      <dl class="facts reveal" style="--d:150ms">
        {
          c.facts.map((f) => (
            <div class="fact">
              <dt class="meta muted">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="prose">
        {
          c.paragraphs.map((p, i) => (
            <p class="reveal" style={`--d:${i * 120}ms`}>
              {p}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .profile {
    padding-top: clamp(6rem, 14vw, 13rem);
  }

  .statement {
    font-size: clamp(2.1rem, 5vw, 5.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    max-width: 20ch;
  }

  .top {
    row-gap: 1.6rem;
  }

  .statement {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .top :global(.globe) {
    grid-column: 1 / -1;
    grid-row: 1;
    justify-self: end;
    width: clamp(96px, 30vw, 150px);
  }

  .line {
    display: block;
  }

  .body {
    margin-top: clamp(4rem, 9vw, 9rem);
    row-gap: 3rem;
    align-items: start;
  }

  .facts {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.6rem;
  }

  .fact {
    padding-top: 0.9rem;
    border-top: 1.5px solid var(--line);
  }

  dd {
    margin-top: 0.35rem;
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .prose {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5em;
    max-width: 38rem;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    line-height: 1.55;
  }

  @media (min-width: 900px) {
    .statement {
      grid-column: 1 / span 10;
      grid-row: 1;
      max-width: 22ch;
    }

    .top :global(.globe) {
      grid-column: 11 / span 2;
      width: min(100%, 230px);
      margin-top: 0.4rem;
    }

    .facts {
      grid-column: 1 / span 4;
    }

    .prose {
      grid-column: 6 / span 6;
    }
  }
</style>
