---
import type { Copy } from '../i18n/en';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const c = copy.profile;
---

<section class="section surface-dark profile" id="profile" aria-labelledby="profile-title">
  <div class="wrap">
    <h2 class="display statement" id="profile-title">
      {
        c.title.map((line, i) => (
          <span class="line reveal" style={`--d:${i * 120}ms`}>
            {line}
          </span>
        ))
      }
    </h2>

    <div class="grid body">
      <dl class="facts reveal" style="--d:150ms">
        {
          c.facts.map((f) => (
            <div class="fact">
              <dt class="meta muted">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="prose">
        {
          c.paragraphs.map((p, i) => (
            <p class="reveal" style={`--d:${i * 120}ms`}>
              {p}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .profile {
    padding-top: clamp(6rem, 14vw, 13rem);
  }

  .statement {
    font-size: clamp(2.45rem, 7.1vw, 8.4rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }

  .line {
    display: block;
  }

  .line:nth-child(2) {
    padding-left: clamp(0.4em, 2vw, 1.4em);
  }

  .line:nth-child(3) {
    padding-left: clamp(0.8em, 4vw, 2.6em);
  }

  .body {
    margin-top: clamp(4rem, 9vw, 9rem);
    row-gap: 3rem;
    align-items: start;
  }

  .facts {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.6rem;
  }

  .fact {
    padding-top: 0.9rem;
    border-top: 1.5px solid var(--line);
  }

  dd {
    margin-top: 0.35rem;
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .prose {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5em;
    max-width: 38rem;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    line-height: 1.55;
  }

  @media (min-width: 900px) {
    .statement {
      max-width: none;
    }

    .facts {
      grid-column: 1 / span 4;
    }

    .prose {
      grid-column: 6 / span 6;
    }
  }
</style>
