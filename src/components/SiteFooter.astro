---
import type { Copy } from '../i18n/en';
import { loadSite } from '../lib/site';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
// Email and LinkedIn are editable from /admin/site. Prerendered pages read them at build time.
const { contact } = await loadSite();
---

<footer class="site-footer surface-dark">
  <p class="name">© 2026 {copy.footer.text}</p>
  <ul>
    <li><a href="/">{copy.footer.home}</a></li>
    {copy.header.pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
    {contact.linkedin && <li><a href={contact.linkedin} rel="noopener">LinkedIn</a></li>}
    <li><a href={`mailto:${contact.email}`}>{copy.contact.emailLabel}</a></li>
  </ul>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 3rem;
    padding: 2.2rem var(--gutter) 2.6rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
  }

  .name {
    color: var(--muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.8rem;
  }

  a {
    display: inline-block;
    padding-block: 0.3rem;
  }
</style>
