---
import sketches from '../config/sketches.json';

export type SketchId = keyof typeof sketches.items;

interface Props {
  id: SketchId;
  class?: string;
}
const { id, class: cls } = Astro.props;
const { width, height, frames } = sketches.items[id];
---

<span class:list={['sketch', cls]} data-boil aria-hidden="true" style={`aspect-ratio:${width}/${height}`}>
  {
    Array.from({ length: frames }, (_, i) => (
      <img src={`/sketches/${id}/${i + 1}.webp`} width={width} height={height} alt="" loading="lazy" decoding="async" />
    ))
  }
</span>

<script>
  import '../scripts/boil';
</script>

<style>
  .sketch {
    position: relative;
    display: block;
    pointer-events: none;
  }

  /* Frames are swapped, never faded: the change has to read as a new drawing. */
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  img:first-child {
    opacity: 1;
  }

  /* The frames are charcoal ink on transparency; on dark surfaces the pencil turns light. */
  :global(.surface-dark) img {
    filter: invert(1);
  }
</style>
