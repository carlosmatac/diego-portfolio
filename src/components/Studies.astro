---
import { scholarships, studies } from '../data/facts';
import type { Copy, EntryCopy, ItemCopy } from '../i18n/en';
import { formatDate, formatPeriod } from '../i18n/format';
import Film from './Film.astro';
import Logo from './Logo.astro';
import Photo from './Photo.astro';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const c = copy.studies;

const when = (e: (typeof studies)[number]['entries'][number]) =>
  e.period ? formatPeriod(e.period, copy) : e.date ? formatDate(e.date, copy) : '';
---

<section class="section surface-light studies" id="studies" aria-labelledby="studies-title">
  <div class="wrap">
    <header class="head grid">
      <h2 class="display title" id="studies-title">{c.title}</h2>
      <p class="lede reveal">{c.lede}</p>
    </header>

    <Film copy={copy} />

    <div class="stages" data-deck>
      <div class="deck-view" data-deck-view>
      {
        studies.map((stage, si) => (
          <div class={`stage ${si % 2 ? 'is-right' : 'is-left'}`} data-card>
           <div class="card-body grid" data-card-body>
            <span class="rule reveal" aria-hidden="true" />
            <div class="where">
              <p class="city display reveal" aria-hidden="true">
                {stage.city}
              </p>
              {stage.photo && (
                <Photo id={stage.photo} copy={copy} class="stage-photo" sizes="(min-width: 900px) 56vw, 92vw" />
              )}
            </div>
            <div class="entries" data-card-scroll>
              {stage.entries.map((entry) => {
                const t = c.entries[entry.id as keyof typeof c.entries] as EntryCopy;
                const place = t.place ?? stage.place;
                const time = when(entry);
                return (
                  <article class="entry reveal">
                    {entry.logo && <Logo id={entry.logo} />}
                    <h3>
                      {entry.link ? <a href={entry.link} rel="noopener">{entry.institution}</a> : entry.institution}
                    </h3>
                    <p class="programme">{t.programme}</p>
                    <p class="meta muted">
                      {t.relation}
                      {time && `, ${time}`}
                      <span class="place">{place}</span>
                    </p>
                    {t.summary && <p class="summary">{t.summary}</p>}
                    {t.points && (
                      <ul class="points">
                        {t.points.map((p) => (
                          <li>{p}</li>
                        ))}
                      </ul>
                    )}
                    {entry.items && t.items && (
                      <ul class="points items">
                        {entry.items.map((item) => {
                          const it = t.items![item.id] as ItemCopy;
                          return (
                            <li>
                              <span class="item-title">
                                {item.link ? <a href={item.link} rel="noopener">{it.title}</a> : it.title}
                              </span>
                              {it.note && <span class="item-note muted">{it.note}</span>}
                            </li>
                          );
                        })}
                      </ul>
                    )}
                  </article>
                );
              })}
            </div>
           </div>
          </div>
        ))
      }
      </div>
    </div>

    <div class="awards grid">
      <span class="rule reveal" aria-hidden="true" />
      <h3 class="display awards-title reveal">{c.scholarships.title}</h3>
      <div class="award-list">
        {
          scholarships.map((a) => {
            const t = c.scholarships.items[a.id as keyof typeof c.scholarships.items] as EntryCopy;
            return (
              <article class="entry reveal">
                {a.logo && <Logo id={a.logo} />}
                <h4>{a.link ? <a href={a.link} rel="noopener">{a.institution}</a> : a.institution}</h4>
                <p class="programme">{t.programme}</p>
                <p class="meta muted">{t.relation}</p>
                {t.summary && <p class="summary">{t.summary}</p>}
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/deck';
</script>

<style>
  .head {
    align-items: end;
    row-gap: 1.5rem;
    margin-bottom: clamp(4rem, 9vw, 8rem);
  }

  .title {
    grid-column: 1 / -1;
    font-size: clamp(4.4rem, 20vw, 24rem);
    letter-spacing: -0.06em;
    line-height: 0.78;
    margin-left: -0.04em;
  }

  .lede {
    grid-column: 1 / -1;
    max-width: 28rem;
    font-size: 1.4rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .stage {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(3.5rem, 8vw, 8rem);
  }

  .card-body {
    row-gap: 1.5rem;
  }

  /*
   * Deck mode (src/scripts/deck.ts, off with reduced motion or without JS): the stages become a pile of sheets
   * held in a sticky view. The front sheet is read, then lifts away and the next one comes forward.
   */
  .stages:global(.deck-on) {
    --peek: 14px;
    --deck-top: calc(var(--peek) * 3 + clamp(10px, 2vh, 22px));
    --deck-bottom: clamp(14px, 3vh, 32px);
    --card-pad: clamp(1.25rem, 3vw, 3rem);
    position: relative;
  }

  .stages:global(.deck-on) .deck-view {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
  }

  .stages:global(.deck-on) .stage {
    position: absolute;
    inset: var(--deck-top) 0 var(--deck-bottom) 0;
    padding: var(--card-pad);
    overflow: hidden;
    background: var(--bg, var(--marble));
    border: 1.5px solid var(--line);
    box-shadow: 0 34px 60px -48px rgba(26, 25, 23, 0.55);
    transform-origin: 50% 0;
    will-change: transform;
  }

  /* Soft edge where a long sheet's content runs under its bottom margin. */
  .stages:global(.deck-on) .stage::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: calc(var(--card-pad) * 1.6);
    background: linear-gradient(to bottom, transparent, var(--bg, var(--marble)) 70%);
    pointer-events: none;
  }

  .stages:global(.deck-on) .rule {
    display: none;
  }

  .stages:global(.deck-on) .card-body,
  .stages:global(.deck-on) .entries {
    will-change: transform;
  }

  .stages:global(.deck-on) .where {
    position: static;
    margin-bottom: 0;
  }

  .stages:global(.deck-on) .where :global(.stage-photo) {
    width: min(100%, calc(36svh * var(--ar)));
  }

  .stages:global(.deck-on) .city {
    font-size: clamp(3.2rem, 15vw, 13rem);
  }

  .rule {
    grid-column: 1 / -1;
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
  }

  .where {
    grid-column: 1 / -1;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-content: start;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .where :global(.stage-photo) {
    width: min(100%, calc(52svh * var(--ar)));
  }

  .city {
    font-size: clamp(3.6rem, 17vw, 14.5rem);
    letter-spacing: -0.055em;
    line-height: 0.8;
    margin-left: -0.04em;
  }

  .entries {
    grid-column: 1 / -1;
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .entry {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    max-width: 36rem;
  }

  .entry + .entry {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1.5px solid var(--line);
  }

  .entry :is(h3, h4) {
    font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.7rem);
    letter-spacing: -0.025em;
    line-height: 1.04;
  }

  .entry :is(h3, h4) a,
  .item-title a {
    text-decoration-color: var(--line);
    text-decoration-thickness: 2px;
    transition: text-decoration-color 0.3s ease;
  }

  .entry :is(h3, h4) a:hover,
  .item-title a:hover {
    text-decoration-color: currentColor;
  }

  .programme {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.25;
  }

  .place {
    display: block;
  }

  .summary {
    margin-top: 0.9rem;
  }

  .points {
    display: grid;
    margin-top: 0.7rem;
  }

  .points li {
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .items li {
    display: grid;
    gap: 0.35rem;
  }

  .item-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .awards {
    padding-block: clamp(2.5rem, 6vw, 5.5rem) 0;
    row-gap: 2rem;
  }

  .awards-title {
    grid-column: 1 / -1;
    font-size: clamp(3rem, 12vw, 8rem);
    letter-spacing: -0.05em;
    line-height: 0.85;
    margin-left: -0.04em;
  }

  .award-list {
    grid-column: 1 / -1;
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 900px) {
    .head {
      row-gap: 0;
    }

    .title {
      grid-column: 1 / span 9;
      font-size: clamp(5rem, 13.5vw, 22rem);
    }

    .awards-title {
      grid-column: 1 / span 5;
      font-size: clamp(3.5rem, 6.4vw, 9rem);
    }

    .award-list {
      grid-column: 7 / span 6;
    }

    .lede {
      grid-column: 9 / span 4;
      align-self: end;
      padding-bottom: 1.2rem;
    }

    .where {
      position: sticky;
      top: 14vh;
      align-self: start;
      margin-bottom: 0;
    }

    .city {
      font-size: clamp(5rem, 11.4vw, 16.5rem);
    }

    .is-left .where {
      grid-column: 1 / span 7;
      grid-row: 2;
    }

    .is-right .where :global(.stage-photo) {
      justify-self: end;
    }

    .is-left .entries {
      grid-column: 8 / span 5;
      grid-row: 2;
    }

    .is-right .where {
      grid-column: 6 / span 7;
      grid-row: 2;
    }

    .is-right .city {
      text-align: right;
      margin-right: -0.04em;
    }

    .is-right .entries {
      grid-column: 1 / span 5;
      grid-row: 2;
    }

    .card-body {
      row-gap: 0;
    }

    .stages:global(.deck-on) .city {
      font-size: clamp(4.5rem, 9.6vw, 14rem);
    }
  }
</style>
