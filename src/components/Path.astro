---
import { stages, type LogoId } from '../data/facts';
import type { Copy, EntryCopy } from '../i18n/en';
import { formatDate, formatPeriod } from '../i18n/format';

interface Props {
  copy: Copy;
}
const { copy } = Astro.props;
const c = copy.path;

/** Intrinsic ratio and display height of each official logo, so nothing shifts while it loads. */
const logos: Record<LogoId, { file: string; w: number; h: number; height: number; blend?: boolean }> = {
  uc3m: { file: 'uc3m.svg', w: 842, h: 303, height: 58 },
  berkeley: { file: 'berkeley.svg', w: 225, h: 42, height: 34 },
  bologna: { file: 'bologna.png', w: 314, h: 314, height: 84, blend: true },
  garrigues: { file: 'garrigues.svg', w: 200, h: 23.557, height: 24 },
  maec: { file: 'maec.svg', w: 2546, h: 531, height: 52 },
  fletcher: { file: 'fletcher.svg', w: 410, h: 48, height: 30 },
  areces: { file: 'areces.png', w: 251, h: 70, height: 34, blend: true },
};

const when = (e: (typeof stages)[number]['entries'][number]) =>
  e.period ? formatPeriod(e.period, copy) : e.date ? formatDate(e.date, copy) : '';
---

<section class="section surface-light path" id="path" aria-labelledby="path-title">
  <div class="wrap">
    <header class="head grid">
      <h2 class="display title" id="path-title">{c.title}</h2>
      <p class="lede reveal">{c.lede}</p>
    </header>

    <div class="stages">
      {
        stages.map((stage, si) => (
          <div class={`stage grid ${si % 2 ? 'is-right' : 'is-left'}`}>
            <span class="rule reveal" aria-hidden="true" />
            <p class="city display reveal" aria-hidden="true">
              {stage.city}
            </p>
            <div class="entries">
              {stage.entries.map((entry) => {
                const t = c.entries[entry.id as keyof typeof c.entries] as EntryCopy;
                const logo = entry.logo ? logos[entry.logo] : undefined;
                const place = t.place ?? stage.place;
                const time = when(entry);
                return (
                  <article class="entry reveal">
                    {logo && (
                      <img
                        class:list={['logo', { blend: logo.blend }]}
                        src={`/logos/${logo.file}`}
                        alt=""
                        height={logo.height}
                        width={Math.round((logo.height * logo.w) / logo.h)}
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <h3>
                      {entry.link ? <a href={entry.link} rel="noopener">{entry.institution}</a> : entry.institution}
                    </h3>
                    <p class="programme">{t.programme}</p>
                    <p class="meta muted">
                      {t.relation}
                      {time && `, ${time}`}
                      <span class="place">{place}</span>
                    </p>
                    {t.summary && <p class="summary">{t.summary}</p>}
                    {t.points && (
                      <ul class="points">
                        {t.points.map((p) => (
                          <li>{p}</li>
                        ))}
                      </ul>
                    )}
                  </article>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    align-items: end;
    row-gap: 1.5rem;
    margin-bottom: clamp(4rem, 9vw, 8rem);
  }

  .title {
    grid-column: 1 / -1;
    font-size: clamp(6.5rem, 27vw, 31rem);
    letter-spacing: -0.06em;
    line-height: 0.78;
    margin-left: -0.04em;
  }

  .lede {
    grid-column: 1 / -1;
    max-width: 28rem;
    font-size: 1.4rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .stage {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(3.5rem, 8vw, 8rem);
    row-gap: 1.5rem;
  }

  .rule {
    grid-column: 1 / -1;
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
  }

  .city {
    grid-column: 1 / -1;
    font-size: clamp(3.6rem, 17vw, 14.5rem);
    letter-spacing: -0.055em;
    line-height: 0.8;
    margin-left: -0.04em;
  }

  .entries {
    grid-column: 1 / -1;
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .entry {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    max-width: 36rem;
  }

  .entry + .entry {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1.5px solid var(--line);
  }

  .logo {
    width: auto;
    margin-bottom: 1.1rem;
  }

  .logo.blend {
    mix-blend-mode: multiply;
  }

  h3 {
    font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.7rem);
    letter-spacing: -0.025em;
    line-height: 1.04;
  }

  h3 a {
    text-decoration-color: var(--line);
    text-decoration-thickness: 2px;
    transition: text-decoration-color 0.3s ease;
  }

  h3 a:hover {
    text-decoration-color: currentColor;
  }

  .programme {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.25;
  }

  .place {
    display: block;
  }

  .summary {
    margin-top: 0.9rem;
  }

  .points {
    display: grid;
    margin-top: 0.7rem;
  }

  .points li {
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .head {
      row-gap: 0;
    }

    .title {
      grid-column: 1 / span 9;
    }

    .lede {
      grid-column: 9 / span 4;
      align-self: end;
      padding-bottom: 1.2rem;
    }

    .city {
      position: sticky;
      top: 14vh;
      align-self: start;
      font-size: clamp(5rem, 11.4vw, 16.5rem);
    }

    .is-left .city {
      grid-column: 1 / span 7;
      grid-row: 2;
    }

    .is-left .entries {
      grid-column: 8 / span 5;
      grid-row: 2;
    }

    .is-right .city {
      grid-column: 6 / span 7;
      grid-row: 2;
      text-align: right;
      margin-right: -0.04em;
    }

    .is-right .entries {
      grid-column: 1 / span 5;
      grid-row: 2;
    }

    .stage {
      row-gap: 0;
    }
  }
</style>
