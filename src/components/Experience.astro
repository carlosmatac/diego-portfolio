---
import type { Copy } from '../i18n/en';
import { formatWhen } from '../i18n/format';
import type { SiteContent } from '../lib/site-types';
import Logo from './Logo.astro';
import Photo from './Photo.astro';

interface Props {
  copy: Copy;
  site: SiteContent;
}
const { copy, site } = Astro.props;
const c = copy.experience;
const x = site.experience;

const groups = [
  { id: 'work', entries: x.work, title: c.work.title },
  { id: 'leadership', entries: x.leadership, title: c.leadership.title },
].filter((g) => g.entries.length);
---

<section class="section surface-light experience" id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <header class="head grid">
      <h2 class="display title" id="experience-title" data-ink={c.title}>{c.title}</h2>
      {x.lede && <p class="lede reveal">{x.lede}</p>}
    </header>

    {
      groups.map((g) => (
        <div class="group">
          <h3 class="group-title display reveal" id={`${g.id}-title`}>{g.title}</h3>
          <ol class="roles" aria-labelledby={`${g.id}-title`}>
            {
              g.entries.map((entry) => {
          const time = formatWhen(entry, copy);
          return (
            <li class="role grid reveal">
              <span class="rule" aria-hidden="true" />
              <div class="side">
                {entry.logo && <Logo id={entry.logo} />}
                <p class="meta muted">
                  {entry.relation}
                  {time && <span class="when">{time}</span>}
                  {entry.place && <span class="when">{entry.place}</span>}
                </p>
              </div>
              <div class="body">
                <h4>{entry.link ? <a href={entry.link} rel="noopener">{entry.institution}</a> : entry.institution}</h4>
                {entry.programme && <p class="programme">{entry.programme}</p>}
                {entry.summary && <p class="summary">{entry.summary}</p>}
                {entry.points.length > 0 && (
                  <ul class="points">
                    {entry.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                )}
                {entry.photo && <Photo id={entry.photo} copy={copy} class="role-photo" sizes="(min-width: 900px) 46vw, 92vw" />}
              </div>
            </li>
          );
        })
            }
          </ol>
        </div>
      ))
    }
  </div>
</section>

<style>
  .head {
    align-items: end;
    row-gap: 1.5rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .title {
    grid-column: 1 / -1;
    font-size: clamp(3.4rem, 15.5vw, 22rem);
    letter-spacing: -0.06em;
    line-height: 0.78;
    margin-left: -0.04em;
  }

  .lede {
    grid-column: 1 / -1;
    max-width: 28rem;
    font-size: 1.4rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .role {
    position: relative;
    row-gap: 1.4rem;
    padding-block: 1.8rem clamp(2.5rem, 5vw, 4.5rem);
  }

  .rule {
    grid-column: 1 / -1;
    margin-bottom: 0.4rem;
  }

  .side,
  .body {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .when {
    display: block;
  }

  .group-title {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 5.5rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
    margin-bottom: 1rem;
  }

  .group + .group {
    margin-top: clamp(4rem, 9vw, 8rem);
  }

  h4 {
    font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.7rem);
    letter-spacing: -0.025em;
    line-height: 1.04;
  }

  h4 a {
    text-decoration-color: var(--line);
    text-decoration-thickness: 2px;
    transition: text-decoration-color 0.3s ease;
  }

  h4 a:hover {
    text-decoration-color: currentColor;
  }

  .programme {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.25;
  }

  .summary {
    margin-top: 0.6rem;
    max-width: 36rem;
  }

  .points {
    display: grid;
    margin-top: 0.7rem;
    max-width: 36rem;
  }

  .points li {
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .body :global(.role-photo) {
    margin-top: 1.6rem;
  }

  @media (min-width: 900px) {
    .head {
      row-gap: 0;
    }

    .title {
      grid-column: 1 / span 9;
      font-size: clamp(5rem, 11vw, 18rem);
    }

    .lede {
      grid-column: 9 / span 4;
      align-self: end;
      padding-bottom: 1.2rem;
    }

    .role {
      row-gap: 0;
    }

    .rule {
      margin-bottom: 1.8rem;
    }

    .side {
      grid-column: 1 / span 4;
    }

    .body {
      grid-column: 6 / span 6;
    }
  }
</style>
