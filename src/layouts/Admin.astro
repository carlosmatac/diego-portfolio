---
import Header from '../components/Header.astro';
import { en as copy } from '../i18n/en';
import Base from './Base.astro';
import '../styles/admin.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Base lang="es" title={`${title} | Backoffice`} description="Backoffice" noindex>
  <Header copy={copy} current="admin" />
  <main class="admin surface-light" id="content">
    <slot />
  </main>
</Base>
