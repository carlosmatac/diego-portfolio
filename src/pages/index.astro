---
import HomePage from '../components/HomePage.astro';
import { loadSite } from '../lib/site';

// Rendered on request so Diego's edits from /admin/site show up without a deploy; the CDN keeps a copy.
export const prerender = false;
const site = await loadSite('live');
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');
---

<HomePage site={site} />
