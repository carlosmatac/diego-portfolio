---
import Header from '../../components/Header.astro';
import Sketch from '../../components/Sketch.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Base from '../../layouts/Base.astro';
import { en as copy } from '../../i18n/en';
import { formatDate } from '../../i18n/format';
import { readingMinutes } from '../../lib/article-format';
import type { Article } from '../../lib/article-types';
import { listArticles } from '../../lib/db';

export const prerender = false;

let articles: Article[] = [];
try {
  articles = await listArticles({ publishedOnly: true });
} catch (e) {
  console.error('blog list failed', e);
}
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');
---

<Base lang={copy.lang} title={copy.blog.pageTitle} description={copy.blog.pageDescription}>
  <a class="skip-link" href="#content">{copy.skip}</a>
  <Header copy={copy} current="blog" />
  <main id="content" tabindex="-1">
    <section class="section surface-light blog" aria-labelledby="blog-title">
      <div class="wrap">
        <header class="head grid">
          <h1 class="display title" id="blog-title">{copy.blog.title}</h1>
          <Sketch id="libro" class="book" />
          <p class="lede reveal">{copy.blog.lede}</p>
        </header>

        {
          articles.length ? (
            <ol class="entries">
              {articles.map((a) => (
                <li class="entry reveal">
                  <span class="rule" aria-hidden="true" />
                  <time class="when meta" datetime={a.publishedAt ?? undefined}>
                    {a.publishedAt ? formatDate(a.publishedAt.slice(0, 10), copy) : ''}
                  </time>
                  <h2 class="what">
                    <a href={`/blog/${a.slug}`}>{a.title}</a>
                  </h2>
                  <p class="note">
                    {a.subtitle && <span>{a.subtitle}</span>}
                    <span class="muted min">
                      {readingMinutes(a)} {copy.blog.minutes}
                    </span>
                  </p>
                </li>
              ))}
            </ol>
          ) : (
            <p class="empty reveal">{copy.blog.empty}</p>
          )
        }
      </div>
    </section>
  </main>
  <SiteFooter copy={copy} />
  <script>
    import '../../scripts/page';
  </script>
</Base>

<style>
  .blog {
    min-height: 80svh;
    padding-top: clamp(7rem, 14vw, 13rem);
  }

  .head {
    row-gap: 1.2rem;
    align-items: end;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .title {
    grid-column: 1 / -1;
    font-size: clamp(6rem, 25vw, 29rem);
    letter-spacing: -0.06em;
    line-height: 0.78;
    margin-left: -0.04em;
  }

  .lede {
    grid-column: 1 / -1;
    font-size: 1.4rem;
    color: var(--muted);
  }

  .head :global(.book) {
    grid-column: 1 / -1;
    grid-row: 1;
    justify-self: end;
    align-self: start;
    width: clamp(110px, 30vw, 150px);
    margin-top: -4.5rem;
  }

  @media (min-width: 900px) {
    .head :global(.book) {
      grid-column: 9 / span 4;
      align-self: end;
      width: clamp(200px, 20vw, 320px);
      margin: 0 0 1rem;
    }
  }

  .empty {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    max-width: 30rem;
  }

  .entry {
    position: relative;
    display: grid;
    column-gap: var(--col-gap);
    padding-block: 1.7rem 2.4rem;
  }

  .rule {
    position: absolute;
    inset: 0 0 auto 0;
    height: 1.5px;
    background: var(--line);
  }

  .when {
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .what {
    font-size: clamp(1.8rem, 1.1rem + 3.2vw, 4rem);
    letter-spacing: -0.035em;
    line-height: 1;
    font-weight: 740;
    font-stretch: 108%;
  }

  .what a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 3px no-repeat;
    transition: background-size 0.5s var(--ease-out);
    padding-bottom: 0.08em;
  }

  .what a:hover,
  .what a:focus-visible {
    background-size: 100% 3px;
  }

  .note {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.9rem;
    max-width: 34rem;
  }

  .min {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
  }

  @media (min-width: 900px) {
    .entry {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .when {
      grid-column: 1 / span 2;
      padding-top: 0.9rem;
      margin-bottom: 0;
    }

    .what {
      grid-column: 3 / span 6;
    }

    .note {
      grid-column: 9 / span 4;
      margin-top: 0.7rem;
    }
  }
</style>
