---
import ArticleView from '../../../components/ArticleView.astro';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import { en as copy } from '../../../i18n/en';
import { getArticleById } from '../../../lib/db';

export const prerender = false;
const article = await getArticleById(Astro.params.id!);
if (!article) return new Response('Not found', { status: 404 });
---

<Base lang={copy.lang} title={`Vista previa: ${article.title}`} description="" noindex>
  <Header copy={copy} current="blog" />
  <main id="content">
    <p class="preview-flag">Vista previa del {article.status === 'published' ? 'artículo publicado' : 'borrador'}. <a href={`/admin/edit/${article.id}`}>Volver al editor</a></p>
    <ArticleView article={article} copy={copy} preview />
  </main>
  <script>
    import '../../../scripts/page';
  </script>
</Base>

<style is:global>
  .preview-flag {
    position: fixed;
    z-index: 70;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    padding: 0.7rem 1.1rem;
    background: var(--charcoal);
    color: var(--marble);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 6px 24px rgb(0 0 0 / 25%);
  }
  .preview-flag a {
    margin-left: 0.8rem;
  }
</style>
